{
  "$schema": "./theme.schema.json",
  "id": "vainnor",
  "name": "Vainnor",
  "description": "Vainnor slate: blue-slate grounds, cool text, lilac accent, rust orange for warnings.",
  "mode": "dark",
  "colors": {
    "background": "#10141b",
    "surface": "#161b24",
    "border": "#35465c",
    "text": "#d3d9e2",
    "muted_text": "#8d98ab",
    "accent": "#b5a8f5",
    "accent_text": "#10141b",
    "danger": "#e5675f",
    "success": "#94c47d",
    "warning": "#e8803f"
  },
  "radius": 2,
  "density": "compact",
  "font": "system-mono",
  "icon_size": 24,
  "layout": "list",
  "motion": false,
  "heading_case": "lowercase",
  "wordmark": "^v█"
}
