{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo deny check:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo tauri build:*)",
      "Bash(cargo tauri dev:*)",
      "Bash(topcoat fmt:*)",
      "Bash(topcoat asset bundle:*)",
      "Bash(topcoat asset list:*)",
      "Bash(topcoat ui list:*)",
      "Bash(pnpm --dir desktop install:*)",
      "Bash(pnpm --dir desktop build:*)",
      "Bash(pnpm --dir desktop test:*)",
      "Bash(pnpm --dir desktop typecheck:*)",
      "Bash(pnpm --dir desktop audit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)",
      "Bash(cargo add:*)",
      "Bash(cargo update:*)",
      "Bash(pnpm --dir desktop add:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.tauri/**)",
      "Read(~/.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(sudo:*)"
    ]
  }
}
